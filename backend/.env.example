# PakToken backend configuration
# Copy this file to backend/.env and fill in real values.

PORT=3000
RPC_URL=http://127.0.0.1:26657
CHAIN_ID=kula
DENOM=stake
PREFIX=cosmos

# Postgres database
DB_USER=postgres
DB_HOST=localhost
DB_NAME=paktoken
DB_PASSWORD=postgres
DB_PORT=5432

# Mnemonics for the sponsor (project creator) and faucet accounts.
# These come from `ignite chain serve` output (alice / bob).
SPONSOR_MNEMONIC=replace-with-alice-mnemonic
FAUCET_MNEMONIC=replace-with-bob-mnemonic